rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Herkes skorları okuyabilir (sıralama tablosu için)
      allow read: if true;
      // Kullanıcılar sadece kendi UID'leriyle, geçerli biçimde ve rekorunu
      // düşürmeden yazabilir; elle şişirilmiş skorlar reddedilir.
      allow create: if isOwner(userId) && validEntry(userId);
      allow update: if isOwner(userId) && validEntry(userId)
                    && request.resource.data.score >= resource.data.score;
      allow delete: if isOwner(userId);
    }
    // Günlük meydan okuma ve haftalık tablo: aynı kurallar, dönem başına
    // oyuncu başına bir kayıt; yalnızca daha yüksek skorla güncellenir.
    match /daily/{dayId}/scores/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && validEntry(userId) && dayId.size() == 10;
      allow update: if isOwner(userId) && validEntry(userId)
                    && request.resource.data.score > resource.data.score;
      allow delete: if isOwner(userId);
    }
    match /weekly/{weekId}/scores/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && validEntry(userId) && weekId.size() == 8;
      allow update: if isOwner(userId) && validEntry(userId)
                    && request.resource.data.score > resource.data.score;
      allow delete: if isOwner(userId);
    }

    match /saves/{userId} {
      // Bulut kaydını yalnızca sahibi okuyup yazabilir
      allow read, write: if isOwner(userId);
    }

    match /names/{key} {
      // İsim ayırmaları herkese açık okunur (isim alınmış mı kontrolü);
      // yalnızca boş bir isim kendi UID'siyle alınabilir, sahibi bırakabilir.
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'name'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 12
                    && key.size() <= 40;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEntry(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'uid', 'date'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.score is int && d.score > 0 && d.score <= 10000
        && d.uid == userId
        && d.date == request.time;
    }
  }
}
