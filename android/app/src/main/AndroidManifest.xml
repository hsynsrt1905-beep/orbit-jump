<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- AdMob Gerçek Kimliğimiz -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1803044471635660~7921303684"
        />

        <!-- Google Play Services Versiyon Desteği -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version"
        />

        <!-- UMP/GDPR Onayı Alınana Kadar Veri Toplamayı Beklet (YENİ) -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" 
        />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Kod boyunca navigator.vibrate() ile titreşim tetikleniyor -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- AdMob'un ağ durumunu okuyabilmesi ve reklam doldurma oranının düşmemesi için önerilir -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Android 13+ Cihazlarda Kişiselleştirilmiş Reklam Eşleşmesi İçin (YENİ) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Android 11+ paket görünürlüğü: reklam tıklamasında tarayıcı/https linklerinin
         açılabilmesi için gerekli. AdMob SDK'sı bunu genelde kendi manifest'inden merge
         eder ama elle de tanımlamak sorun çözmede ekstra güvence sağlar. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
